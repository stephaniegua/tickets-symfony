{% extends 'base.html.twig' %}

{% block title %}Statut index{% endblock %}

{% block body %}
    <h1>Statut index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for statut in statuts %}
            <tr>
                <td>{{ statut.id }}</td>
                <td>{{ statut.nom }}</td>
                <td>
                    <a href="{{ path('admin_statut_edit', {'id': statut.id}) }}">Modifier</a>
                    <a href="{{ path('admin_statut_delete', {'id': statut.id}) }}"
                      onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce statut ?')">Supprimer</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('admin_statut_new') }}">Create new</a>
{% endblock %}
